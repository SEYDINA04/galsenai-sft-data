# ───────────────────────────────────────────────────────────────
#  .gitignore — galsenai-sft-data
# ───────────────────────────────────────────────────────────────
# Secrets
.env

# Données (versionnées via DVC/HF, pas via Git) — on garde la structure vide.
data/**
!data/
!data/**/
!data/**/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Outils
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Modèles LID téléchargés
*.bin
*.ftz

# Journaux de build
logs/

# Notes locales (post-mortem machine : hors périmètre du dépôt)
docs/memoire.md
